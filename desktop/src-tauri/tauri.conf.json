{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vid Sync",
  "version": "0.2.0",
  "identifier": "io.github.drflgd.vidsync",
  "build": {
    "frontendDist": "../../build/desktop/ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Vid Sync",
        "width": 1360,
        "height": 880,
        "minWidth": 860,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Video",
    "shortDescription": "Keep a library of YouTube videos, by channel, playlist and creator, up to date",
    "longDescription": "Add YouTube channels, playlists or videos by their link. Vid Sync downloads them with yt-dlp, organises them by channel, playlist and creator, checks for new videos on a schedule, and audits which videos of each source are missing.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../../build/tools/": "./"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
